#!/bin/bash

set -eu

LOGFILE="$(mktemp -p "$PWD")"
echo "Logging at $LOGFILE ..."

# Write bash trace to log file.
exec 69> "$LOGFILE"
BASH_XTRACEFD=69
set -x

export DEBIAN_FRONTEND=noninteractive

log() {
  $@ >> "$LOGFILE"
}

run_as_root() {
  local run_pref
  run_pref="sudo"
  if [[ "$USER" == "root" ]]; then
    run_pref=""
  fi
  $run_pref $@
}

update_packages() {
  echo -n "Updating packages... "

  log run_as_root apt-get update
  log run_as_root apt-get dist-upgrade -y
  log run_as_root apt-get autoremove -y

  echo "DONE"
}

check_version() {
  local current minimal
  current="$1"
  minimal="$2"
  latest="$(echo -e "$current\n$minimal" | sort -Vr | head -1)"
  ([ "$latest" == "$current" ] && echo "OK") \
    || (echo -e "OUTDATED (Current: $current, Available: >$minimal)" && false)
}

check_gcc() {
  local version cmd="gcc"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | grep -Po "\d+\.\d+\.\d+")"
  check_version "$version" "16.0.1"
}

check_gpp() {
  local version cmd="g++"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | grep -Po "\d+\.\d+\.\d+")"
  check_version "$version" "16.0,1"
}

check_java() {
  local version cmd="java"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | head -1 | grep -Po "\d+\.\d+\.\d+")"
  check_version "$version" "17.0.20"
}

check_python() {
  local version cmd="python3"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | grep -Po "\d+\.\d+\.\d+$")"
  check_version "$version" "3.12.3"
}

check_vim() {
  local version cmd="vim"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | head -1 | grep -Po "\d+\.\d+")"
  check_version "$version" "9.1"
}

check_emacs() {
  local version cmd="emacs"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | head -1 | grep -Po "\d+\.\d+$")"
  check_version "$version" "29.3"
}

check_nano() {
  local version cmd="nano"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | head -1 | grep -Po "\d+\.\d+$")"
  check_version "$version" "7.2"
}

check_sublime_text() {
  local version cmd="subl"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | grep -Po "\d+$")"
  check_version "$version" "4215"
}

check_vscode() {
  local version cmd="code"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version --no-sandbox --user-data-dir /tmp | grep -Po "^\d+\.\d+\.\d+$")"
  check_version "$version" "1.143.1"
}

check_gedit() {
  local version cmd="gedit"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | grep -Po "\d+\.\d+$")"
  check_version "$version" "46.2"
}

check_geany() {
  local version cmd="geany"
  echo -n "Checking $cmd ($(which $cmd))... "
  version="$($cmd --version | cut -d '(' -f 1 | grep -Po "\d+\.\d+")"
  check_version "$version" "2.0"
}

check_pycharm() {
  local version cmd
  echo -n "Checking pycharm ("
  cmd="$(find /opt/pycharm-*/bin/pycharm.sh)"
  echo -n "$(which $cmd))... "
  version="$($cmd --version | grep "PyCharm" | grep -Po "\d+\.\d+\.\d+")"
  check_version "$version" "2026.2.3"
}

check_intellij() {
  local version cmd
  echo -n "Checking intellij ("
  cmd="$(find /opt/idea-*/bin/idea.sh)"
  echo -n "$(which $cmd))... "
  version="$($cmd --version | grep "IntelliJ" | grep -Po "\d+\.\d+\.\d+")"
  check_version "$version" "2026.2.3"
}

check_packages() {
  check_gcc
  check_gpp
  check_java
  check_python
  check_vim
  check_emacs
  check_nano
  check_sublime_text
  check_vscode
  check_gedit
  check_geany
  check_pycharm
  check_intellij
}

enable_ssh() {
  echo -n "Starting ssh... "

  run_as_root systemctl enable ssh
  run_as_root systemctl start ssh

  run_as_root ufw enable
  run_as_root ufw allow ssh

  echo "DONE"
}

restrict_ssh() {
  # Allow only the ADMIN_USER to be able to SSH to other machines.
  #
  ADMIN_USER="admin"  # TODO: this is bad because there are now two definitions
                      # of ADMIN_USER. We should think of somehow sourcing it
                      # from vars.sh from the project root.
  # Allow only the ADMIN USER to connect out on Port 22 (SSH)
  run_as_root iptables -A OUTPUT -p tcp --dport 22 -m owner --uid-owner "$ADMIN_USER" -j ACCEPT
  #
  # Allow established connections (so incoming users don't get disconnected)
  run_as_root iptables -A OUTPUT -p tcp --sport 22 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  #
  # Block all other local users from initiating outbound traffic on Port 22
  run_as_root iptables -A OUTPUT -p tcp --dport 22 -j REJECT --reject-with icmp-port-unreachable
}

update_packages

enable_ssh
restrict_ssh

check_packages
